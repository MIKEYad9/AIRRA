rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Rule 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user paths
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /syncs/{syncId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
